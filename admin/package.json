{
  "name": "medvexa-admin-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "vite --port=3001 --host=0.0.0.0",
    "build": "vite build && node -e \"import('fs').then(fs => fs.copyFileSync('server.js', 'dist/server.js'))\"",

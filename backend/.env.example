# ==============================================================================
# HealthDiscover Backend Environment Configuration
# ==============================================================================

# General Application Settings
PROJECT_NAME="HealthDiscover API"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Allowed CORS Origins (JSON list format or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (User data & Auth)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/healthdiscover_db"

# ------------------------------------------------------------------------------
# Neo4j Configuration (Doctors, Hospitals, Specialities, Affiliations Graph)
# ------------------------------------------------------------------------------
# Format: bolt://<host>:<port> or neo4j+s://<dbid>.databases.neo4j.io (for Neo4j Aura)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password"
NEO4J_DATABASE="neo4j"

# ------------------------------------------------------------------------------
# JWT Authentication Configuration
# ------------------------------------------------------------------------------
# Generate a secure key with: openssl rand -hex 32
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# HealthDiscover Backend Environment Configuration (100% PostgreSQL)
# ==============================================================================

# General Application Settings
PROJECT_NAME="HealthDiscover API"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Allowed CORS Origins (JSON list format or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Users, Doctors, Hospitals, and Affiliations)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
# Or direct Neon URL: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/healthdiscover_db"

# ------------------------------------------------------------------------------
# JWT Authentication Configuration
# ------------------------------------------------------------------------------
# Generate a secure key with: openssl rand -hex 32
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
